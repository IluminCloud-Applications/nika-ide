{
  "appId": "com.nikaide.app",
  "productName": "Nika IDE",
  "directories": {
    "output": "dist-release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    "templates/**/*"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/node-pty"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg"],
    "icon": "build/icon.png"
  },
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Development",
    "icon": "build/icon.png"
  }
}
